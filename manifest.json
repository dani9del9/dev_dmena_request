{
  "manifest_version": 3,
  "name": "dmena_request",
  "version": "1.8.1",
  "description": "Modifica cabeceras de petición/respuesta y añade o quita parámetros de URL mediante reglas (estilo Requestly).",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "dmena_request",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/orchid16.png",
      "32": "icons/orchid32.png",
      "48": "icons/orchid48.png",
      "128": "icons/orchid128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/orchid16.png",
    "32": "icons/orchid32.png",
    "48": "icons/orchid48.png",
    "128": "icons/orchid128.png"
  }
}