{
  "manifest_version": 3,
  "name": "dmena_request",
  "version": "1.2.0",
  "description": "Modifica cabeceras de petición/respuesta y añade o quita parámetros de URL mediante reglas (estilo Requestly).",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "rules.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "dmena_request",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/mint16.png",
      "32": "icons/mint32.png",
      "48": "icons/mint48.png",
      "128": "icons/mint128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/mint16.png",
    "32": "icons/mint32.png",
    "48": "icons/mint48.png",
    "128": "icons/mint128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "reqtweak@dani9del9",
      "strict_min_version": "128.0"
    }
  }
}